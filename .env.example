# Leave real calling disabled until you choose to activate it.
TWILIO_ENABLED=0
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
PUBLIC_BASE_URL=
TWILIO_NUMBERS_JSON=[]
# Optional services stay disabled until you configure them yourself.
TWILIO_TRANSCRIPTION_ENABLED=0
EMAIL_ENABLED=0
RESEND_API_KEY=
EMAIL_FROM=
# Automatic daily SQLite backups, seven snapshots, persistent disk required online.
BACKUP_ENABLED=1

# Optional external HTTP scheduler; leave unset to disable wake requests.
# DISCOVERY_TRIGGER_TOKEN=use-a-random-secret-at-least-32-characters
# On the scheduler only: DISCOVERY_APP_URL=https://your-canonical-app-domain
